node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
dist/
build/
.pytest_cache/
.DS_Store
Thumbs.db

# model weights and caches - never commit, always pre-staged separately
*.gguf
*.safetensors
models/
.cache/

# Runtime data: the database, the content-addressed file store and the page cache live in
# $STRATUM_HOME (D:\stratum\data by default, outside the repo). These only matter if someone points
# STRATUM_HOME inside the checkout.
backend/data/
*.db
*.db-wal
*.db-shm

# Generated replies and reports. The workbench's workspace is ~/.stratum/workspace; this covers a
# deliverables/ folder in the repo from earlier runs or from pointing STRATUM_DELIVERABLES here.
/deliverables/

# corpus/sample/ IS tracked: eight small files, every one stamped SAMPLE, generated by
# backend/scripts/make_sample_corpus.py. Real documents people drop in never are.
corpus/downloads/
corpus/real/
corpus/*.pdf
corpus/*.xlsx

# Working scratch: research and revived code kept on disk while forking, not part of the product.
.scratch/

# Claude Code worktrees and local settings — never commit a worktree tree.
.claude/worktrees/
.claude/settings.local.json

# Working notes for an AI coding assistant, not part of the product: kept on disk, deliberately out of
# the repository, so a reader of this repo meets the README rather than a briefing written for a tool.
CLAUDE.md

# `npm run record-demo` writes its MP4 here. Recordings are output, not source.
videos/
