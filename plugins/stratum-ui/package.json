{
  "name": "@stratum/dsh-client-ui-base",
  "description": "Stratum client/host plugin for DeepSeek Harness: brand, library, evidence viewer, facts, topics, metrics, lanes and tools that call the Stratum backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "stratum": {
    "harnessVersion": "0.1.1-rc.2",
    "forkedFrom": "Faraday (@blind-flange/dsh-client-ui-base, SIH26117)"
  }
}
